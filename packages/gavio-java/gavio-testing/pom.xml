  <description>GavioTestKit, GavioAssertions and test fixtures.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.manojmallick</groupId>
      <artifactId>gavio-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.manojmallick</groupId>
