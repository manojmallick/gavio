      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.manojmallick</groupId>
      <artifactId>gavio-provider-anthropic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.manojmallick</groupId>
      <artifactId>gavio-provider-gemini</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.manojmallick</groupId>
      <artifactId>gavio-provider-ollama</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
