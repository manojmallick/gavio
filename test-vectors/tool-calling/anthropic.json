{
  "feature": "F-ADP-03",
  "provider": "anthropic",
  "description": "Anthropic Messages API tool calling: tool_use / tool_result content blocks. Consecutive tool-role messages merge into one user turn.",
  "requestCases": [
    {
      "id": "declares-tools-auto",
      "request": {
        "model": "claude-sonnet-4-5",
        "provider": "anthropic",
        "messages": [
          {
            "role": "system",
            "content": "You are a travel assistant."
          },
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          }
        ],
        "options": {
          "temperature": 0.2,
          "maxTokens": 256
        },
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a city",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "celsius",
                    "fahrenheit"
                  ]
                }
              },
              "required": [
                "city"
              ]
            }
          },
          {
            "name": "ping",
            "description": "Check connectivity"
          }
        ],
        "toolChoice": "auto"
      },
      "expectedPayload": {
        "model": "claude-sonnet-4-5",
