{
  "feature": "F-ADP-03",
  "provider": "gemini",
  "description": "Gemini generateContent tool calling: functionCall / functionResponse parts. Gemini sends no call ids, so the adapter synthesises call_<index>_<name>; results are matched back by name and consecutive tool-role messages merge into one user turn.",
  "requestCases": [
    {
      "id": "declares-tools-auto",
      "request": {
        "model": "gemini-2.0-flash",
        "provider": "gemini",
        "messages": [
          {
            "role": "system",
            "content": "You are a travel assistant."
          },
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          }
        ],
        "options": {
          "temperature": 0.2,
          "maxTokens": 256
        },
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a city",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "celsius",
                    "fahrenheit"
                  ]
                }
              },
              "required": [
                "city"
              ]
            }
          },
          {
            "name": "ping",
            "description": "Check connectivity"
          }
        ],
        "toolChoice": "auto"
      },
      "expectedPayload": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "What's the weather in Paris?"
              }
            ]
          }
        ],
        "generationConfig": {
          "temperature": 0.2,
          "maxOutputTokens": 256
        },
        "systemInstruction": {
          "parts": [
            {
              "text": "You are a travel assistant."
            }
          ]
        },
        "tools": [
          {
            "functionDeclarations": [
              {
                "name": "get_weather",
                "description": "Get the current weather for a city",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "celsius",
                        "fahrenheit"
                      ]
                    }
                  },
                  "required": [
                    "city"
                  ]
                }
              },
              {
                "name": "ping",
                "description": "Check connectivity"
              }
            ]
          }
        ],
        "toolConfig": {
          "functionCallingConfig": {
            "mode": "AUTO"
          }
        }
      }
    },
