    {
      "id": "history-parallel-calls-stay-separate-tool-messages",
      "request": {
        "model": "llama3.1",
        "provider": "ollama",
        "messages": [
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          },
          {
            "role": "assistant",
            "content": "Checking both.",
            "toolCalls": [
              {
                "id": "call_0_get_weather",
                "name": "get_weather",
                "arguments": {
                  "city": "Paris"
                }
              },
              {
                "id": "call_1_get_time",
                "name": "get_time",
                "arguments": {
                  "city": "Rome"
                }
              }
            ]
          },
          {
            "role": "tool",
            "toolCallId": "call_0_get_weather",
            "content": "{\"temp_c\":18}"
          },
          {
            "role": "tool",
            "toolCallId": "call_1_get_time",
            "content": "14:05"
          }
        ],
        "options": {
          "temperature": 0.2,
          "maxTokens": 256
        },
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a city",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "celsius",
                    "fahrenheit"
                  ]
                }
              },
              "required": [
                "city"
              ]
            }
          }
        ]
      },
      "expectedPayload": {
        "model": "llama3.1",
        "messages": [
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          },
          {
            "role": "assistant",
            "content": "Checking both.",
            "tool_calls": [
              {
                "function": {
                  "name": "get_weather",
                  "arguments": {
                    "city": "Paris"
                  }
                }
              },
              {
                "function": {
                  "name": "get_time",
                  "arguments": {
                    "city": "Rome"
                  }
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": "{\"temp_c\":18}",
            "tool_name": "get_weather"
          },
          {
            "role": "tool",
            "content": "14:05",
            "tool_name": "get_time"
          }
        ],
        "stream": false,
        "options": {
          "temperature": 0.2
        },
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get the current weather for a city",
              "parameters": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "celsius",
                      "fahrenheit"
                    ]
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          }
        ]
      }
    },
