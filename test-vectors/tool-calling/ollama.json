{
  "feature": "F-ADP-03",
  "provider": "ollama",
  "description": "Ollama /api/chat tool calling, per the documented shape (object arguments, no call ids, tool results name the tool in tool_name, no tool_choice). Not exercised against a live server.",
  "requestCases": [
    {
      "id": "declares-tools-auto",
      "request": {
        "model": "llama3.1",
        "provider": "ollama",
        "messages": [
          {
            "role": "system",
            "content": "You are a travel assistant."
          },
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          }
        ],
        "options": {
          "temperature": 0.2,
          "maxTokens": 256
        },
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a city",
            "inputSchema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "celsius",
                    "fahrenheit"
                  ]
                }
              },
              "required": [
                "city"
              ]
            }
          },
          {
            "name": "ping",
            "description": "Check connectivity"
          }
        ],
        "toolChoice": "auto"
      },
      "expectedPayload": {
        "model": "llama3.1",
        "messages": [
          {
            "role": "system",
            "content": "You are a travel assistant."
          },
          {
            "role": "user",
            "content": "What's the weather in Paris?"
          }
        ],
        "stream": false,
        "options": {
          "temperature": 0.2
        },
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get the current weather for a city",
              "parameters": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "celsius",
                      "fahrenheit"
                    ]
                  }
                },
                "required": [
                  "city"
                ]
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "ping",
              "description": "Check connectivity",
              "parameters": {
                "type": "object",
                "properties": {}
              }
            }
          }
        ]
      }
    },
