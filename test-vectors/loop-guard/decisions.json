{
  "feature": "F-REL-09",
  "description": "Loop guard: pure limit evaluation (decisionCases), run-state accumulation over a sequence of calls (runCases), the root-run resolver and its bounded map (rootRunCases), and invalid policies (policyErrorCases). Semantics: spec/README.md, 'Loop guard'.",
  "decisionCases": [
    {
      "id": "no-limits-never-breach",
      "policy": {
        "id": "agent-loop",
        "action": "stop"
      },
      "state": {
        "steps": 1000,
        "costUsd": 1000.0,
        "elapsedSeconds": 1000000.0,
        "toolCalls": [
          {
            "name": "search",
            "argumentsHash": "hash-search-cats",
            "count": 99
          }
        ]
      },
      "expected": {
        "allowed": true,
        "action": "allow",
        "breached": null,
        "breaches": [],
        "reason": "within_limits",
        "steps": 1000,
        "costUsd": 1000.0,
        "elapsedSeconds": 1000000.0,
        "repeatedToolCall": null
      },
      "expectedAbsent": [
        "targetModel"
      ]
    },
