  "runCases": [
    {
      "id": "max-steps-stops-a-runaway-run",
      "policy": {
        "id": "agent-loop",
        "action": "stop",
        "maxSteps": 3
      },
      "calls": [
        {
          "atSeconds": 0,
          "costUsd": 0.01
        },
        {
          "atSeconds": 1,
          "costUsd": 0.01
        },
        {
          "atSeconds": 2,
          "costUsd": 0.01
        },
        {
          "atSeconds": 3,
          "costUsd": 0.01
        },
        {
          "atSeconds": 4,
          "costUsd": 0.01
        }
      ],
      "expectedActions": [
        "allow",
        "allow",
        "allow",
        "stop",
        "stop"
      ],
      "expectedBreached": [
        null,
        null,
        null,
        "max_steps",
        "max_steps"
      ],
      "expectedSteps": [
        0,
        1,
        2,
        3,
        3
      ],
      "expectedCostUsd": [
        0.0,
        0.01,
        0.02,
        0.03,
        0.03
      ],
      "expectedElapsedSeconds": [
        0.0,
        1.0,
        2.0,
        3.0,
        4.0
      ]
    },
