          "toolCalls": [
            {
              "name": "search",
              "arguments": {
                "q": "cats",
                "limit": 5
              }
            }
          ]
        }
      ],
      "expectedActions": [
        "allow",
        "allow",
        "allow",
        "allow",
        "allow",
        "stop"
      ],
      "expectedBreached": [
