{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gavio.io/schema/AuditRecord.v1.json",
  "title": "AuditRecord",
  "description": "Immutable, per-request audit entry. Carries metadata and content HASHES only — never raw prompt/response text.",
  "type": "object",
  "required": [
    "traceId", "provider", "model", "timestampUtc",
    "promptHash", "responseHash", "tokenUsage", "schemaVersion"
  ],
  "properties": {
    "traceId": { "type": "string" },
    "parentTraceId": { "type": ["string", "null"] },
    "agentId": { "type": ["string", "null"] },
    "sessionId": { "type": ["string", "null"] },
    "subjectId": { "type": ["string", "null"], "description": "Data-subject identifier (from request metadata) for GDPR Art. 17 right-to-erasure (F-QUA-09). Null when not supplied." },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "modelVersion": { "type": "string" },
    "promptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the redacted prompt." },
    "responseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the response." },
    "tokenUsage": {
      "type": "object",
      "required": ["promptTokens", "completionTokens", "totalTokens"],
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "costUsd": { "type": "number", "minimum": 0 },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "piiEntityTypes": { "type": "array", "items": { "type": "string" } },
    "piiEntityCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "interceptorsFired": { "type": "array", "items": { "type": "string" } },
    "cacheHit": { "type": "boolean" },
    "cacheType": { "type": ["string", "null"] },
    "guardrailOutcome": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "HITL", null] },
    "riskScore": { "type": ["number", "null"] },
    "lineage": {
      "anyOf": [{ "$ref": "#/$defs/promptLineage" }, { "type": "null" }],
      "description": "Prompt provenance (F-OBS-04, v0.3.0): template, variable bindings, and RAG chunk sources. Null when not supplied."
    },
    "toolCalls": {
      "type": "array",
      "description": "Tool calls the model requested in this response (F-ADP-03): tool name and arguments hash only — never the arguments. Omitted from the record (and from the hash-chain input) when the response had no tool calls, so existing chains keep verifying. Python binds this key as tool_calls.",
      "items": {
        "type": "object",
        "required": ["name", "argumentsHash"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "argumentsHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the canonical JSON of the call arguments (see ToolCall). Python binds this key as arguments_hash."
          }
        },
        "additionalProperties": false
      }
    },
    "loopGuard": {
      "anyOf": [
        {
          "type": "object",
          "required": ["policyId", "runId", "action", "steps"],
          "properties": {
            "policyId": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "enum": ["allow", "stop", "fallback", "dry_run"] },
            "breached": { "type": ["string", "null"], "enum": ["max_steps", "max_cost", "max_wall_time", "repeated_tool_call", null] },
            "steps": { "type": "integer", "minimum": 0 },
            "costUsd": { "type": "number", "minimum": 0 },
            "elapsedSeconds": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "The loop guard's verdict on this call (F-REL-09): policy, root run id, action, the first limit reached, and the run's step count, cost and elapsed time before the call — counts only, never tool arguments (a repeated tool call is identified in the decision, not here). Omitted from the record (and from the hash-chain input) when no loop guard is in the chain, so existing chains keep verifying. Python binds this key as loop_guard and the nested keys as policy_id, run_id, cost_usd and elapsed_seconds."
    },
    "previousHash": { "type": "string", "description": "SHA-256 of the previous record (hash-chain, F-OBS-02, v0.2.0). Empty in v0.1.0." },
    "schemaVersion": { "type": "string", "const": "1.0" }
  },
  "$defs": {
    "promptLineage": {
      "type": "object",
      "description": "Provenance for a rendered prompt. RAG chunk text is never stored — only source references.",
      "properties": {
        "templateId": { "type": ["string", "null"] },
        "templateVersion": { "type": ["string", "null"] },
        "variables": { "type": "object", "additionalProperties": true },
        "ragChunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": { "type": "string" },
              "chunkId": { "type": ["string", "null"] },
              "score": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
