  "sdks": ["python", "javascript", "java"],
  "entryFormat": {
    "available": "{ \"path\": \"examples/<sdk>/<id>-<name>\", \"entry\": [optional override], \"cliOnly\": [optional], \"skipRun\": \"optional reason\" }",
    "planned": "{ \"status\": \"planned\", \"reason\": \"...\" } - a gap that will be ported; the directory must not exist yet",
    "n/a": "{ \"status\": \"n/a\", \"reason\": \"...\" } - intentionally not applicable for this SDK",
    "cliOnly": "Steps that need the Python-only `gavio` CLI. CLIs stay Python-only; the library API behind them is ported to every SDK."
  },
